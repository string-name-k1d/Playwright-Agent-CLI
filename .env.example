# pw-cli-agent environment variables
# Copy to .env and fill in your values

# OpenCode model (e.g. anthropic/claude-sonnet-4-6, openai/gpt-4o)
OPENCODE_MODEL=

# Default target URL for testing
TARGET_URL=

# Run browsers headed (true/false)
PW_CLI_HEADED=false

# Custom artifacts output directory
# PW_CLI_OUTPUT_DIR=./artifacts

# OpenCode server URL (remote server mode — leave EMPTY; local CLI mode is the default)
# If set, the agent connects to this server instead of running opencode CLI locally.
# NOTE: `opencode serve --port 4096` currently crashes with "Unexpected error / ServeError"
# in opencode 1.18.x, and on Windows `opencode` may be the desktop app (OpenCode.exe),
# not a CLI. Leave this empty to use the working local CLI mode.
OPENCODE_SERVER_URL=
