# pw-cli-agent environment variables
# Copy to .env and fill in your values

# OpenCode model (e.g. anthropic/claude-sonnet-4-6, openai/gpt-4o)
OPENCODE_MODEL=

# Default target URL for testing
TARGET_URL=

# Run browsers headed (true/false)
PW_CLI_HEADED=false

# Custom artifacts output directory
# PW_CLI_OUTPUT_DIR=./artifacts

# OpenCode server URL (for connecting to host-running opencode serve)
# If set, the agent connects to this server instead of running opencode CLI locally.
# Start the server on host: opencode serve --port 4096
# Then set: OPENCODE_SERVER_URL=http://host.docker.internal:4096
OPENCODE_SERVER_URL=
