# pw-cli-agent environment variables
# Copy to .env and fill in your values (do NOT commit .env — it is gitignored)

# AI agent backend: opencode (default) or api (any OpenAI-compatible chat-completions API)
# AGENT_PROVIDER=opencode

# ---- opencode backend (default) ----
# OpenCode model (e.g. anthropic/claude-sonnet-4-6, openai/gpt-4o)
OPENCODE_MODEL=

# Opencode agent used for generation (default: the non-agentic `codegen` agent)
# OPENCODE_AGENT=codegen

# OpenCode server URL (remote server mode — leave EMPTY; local CLI mode is the default)
# If set, the agent connects to this server instead of running opencode CLI locally.
# NOTE: `opencode serve --port 4096` currently crashes with "Unexpected error / ServeError"
# in opencode 1.18.x, and on Windows `opencode` may be the desktop app (OpenCode.exe),
# not a CLI. Leave this empty to use the working local CLI mode.
OPENCODE_SERVER_URL=

# ---- api backend (used when AGENT_PROVIDER=api) ----
# API key for the OpenAI-compatible backend (env only — never commit; OPENAI_API_KEY also works)
# AGENT_API_KEY=

# Base URL of the OpenAI-compatible endpoint (default: https://api.openai.com/v1).
# Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1, http://host.docker.internal:11434/v1
# AGENT_API_BASE_URL=https://api.openai.com/v1

# Default model for the api backend (e.g. gpt-4o, anthropic/claude-sonnet-4-6 via OpenRouter)
# AGENT_API_MODEL=

# Request timeout (ms) for the api backend (default: 300000)
# AGENT_API_TIMEOUT=300000

# Default target URL for testing
TARGET_URL=

# Run browsers headed (true/false)
PW_CLI_HEADED=false

# Custom artifacts output directory
# PW_CLI_OUTPUT_DIR=./artifacts

# HTTP Basic Auth for sites behind an nginx auth gate (Authenticated Access Only)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Default browser profile path for saved login state
# STORAGE_STATE=./auth-profile
